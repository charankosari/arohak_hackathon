# Copy to .env:  Windows -> copy .env.example .env   |   bash -> cp .env.example .env

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml at the repo root (port 5433 avoids clashing with
# a local PostgreSQL on 5432).
DATABASE_URL="postgresql://meridian:meridian_dev_pw@localhost:5433/meridian?schema=public"

# --- Cache / rate-limit store ---------------------------------------------
# Optional but recommended. Matches docker-compose.yml (6380 avoids clashing
# with a local Redis on 6379). Leave blank to run without caching.
REDIS_URL="redis://localhost:6380"

# --- Auth -----------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="12h"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
