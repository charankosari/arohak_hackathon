# Copy to .env:  Windows -> copy .env.example .env   |   bash -> cp .env.example .env

# --- Server ---------------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8001

# --- Knowledge base -------------------------------------------------------
# Source PDF. Relative paths resolve from the repo root.
KB_PDF_PATH=../AROHAK_Hotel_Information_For_RAG.pdf
# Built index. Regenerate with:  python -m scripts.ingest
KB_INDEX_PATH=data/index.json

# --- Live hotel data ------------------------------------------------------
# The Express API. The agent calls it for availability and room inventory,
# which the PDF explicitly says must come from live data (PDF section 12).
# Leave blank to disable live lookups and answer purely from the document.
BACKEND_URL=http://localhost:4000
BACKEND_TIMEOUT_SECONDS=5

# --- Retrieval tuning -----------------------------------------------------
# Minimum retrieval score before the bot will answer from the document at all.
# Below this it says the information is not in the document rather than
# guessing (PDF section 12 grounding rule).
MIN_SCORE=2.5
