# Copy to .env.local for local development:
#   Windows:      copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
#
# On Vercel, set this in Project Settings -> Environment Variables instead.
# Without it the app falls back to http://localhost:4000, which only works on
# the machine running the API - a deployed site would call the visitor's own
# computer and every request would fail.
NEXT_PUBLIC_API_URL=http://localhost:4000
